# ==============================================
# MCP SERVER — porta e credencial de acesso
# ==============================================
PORT=5100
HOST=127.0.0.1

# Senha que o Hermes envia em Authorization: Bearer <MCP_API_KEY>
# Gerar com: openssl rand -hex 32
MCP_API_KEY=CHANGE_ME_openssl_rand_hex_32

# Allowlist de IPs (CSV). Vazio = desligada.
# Ex.: MCP_IP_ALLOWLIST=203.0.113.10,203.0.113.11
MCP_IP_ALLOWLIST=

# Modo de transporte. 0 = stateless (padrão), 1 = stateful com Mcp-Session-Id.
MCP_STATEFUL=0

# ==============================================
# BACKEND DO FAMACHAT — usuário de serviço
# ==============================================
FAMACHAT_API_URL=http://127.0.0.1:5000
FAMACHAT_SERVICE_EMAIL=hermes-agent@famachat.com.br
FAMACHAT_SERVICE_PASSWORD=CHANGE_ME_gerada_no_provisionamento
FAMACHAT_REQUEST_TIMEOUT_MS=60000
FAMACHAT_MAX_RESPONSE_BYTES=1048576

# ==============================================
# POSTGRES DE PRODUÇÃO
# ==============================================
DATABASE_URL=postgresql://user:password@host:5432/database
DB_STATEMENT_TIMEOUT_MS=30000
DB_MAX_ROWS=1000
DB_POOL_MAX=5

# ==============================================
# OBSERVABILIDADE
# ==============================================
AUDIT_LOG_PATH=/var/www/mcp-famachat/logs/audit.jsonl
LOG_LEVEL=info
